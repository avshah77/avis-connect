# AVIS Connect — Environment Variables
# Copy to .env and fill in real values. Never commit .env

# App
CONNECT_ENV=development
CONNECT_SECRET=replace-with-a-long-random-secret
CONNECT_HOST=0.0.0.0
CONNECT_PORT=8001

# Database — shared Neon PostgreSQL (same instance as RMS3, connect.* schema)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Encryption key for credential vault (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CONNECT_ENCRYPTION_KEY=replace-with-fernet-key

# Admin credentials
CONNECT_ADMIN_USER=admin
CONNECT_ADMIN_PASSWORD=change-me-now
